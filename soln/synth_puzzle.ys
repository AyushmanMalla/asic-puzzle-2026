read_liberty -ignore_miss_func pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
read_verilog puzzle_netlist.v

# Prepare the design
prep -top puzzle

# Flatten the design to remove standard cell sub-hierarchies
flatten

# Optimize the logic
opt -full
opt_clean -purge

# Print statistics of the simplified design
stat

# Write out the simplified verilog
write_verilog -noattr puzzle_simplified.v

